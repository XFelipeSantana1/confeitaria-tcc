# Copie para `backend/.env` e troque TUDO que estiver como <troque-isto>.
#
# Este arquivo vai para o Git: ele serve para dizer "que variáveis existem",
# não para guardar o valor delas. A senha do banco e as chaves de assinatura
# nunca entram aqui — quem clona o projeto escolhe as suas.

# --- Banco de dados (veja docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=<troque-isto>
DB_PASSWORD=<troque-isto>
DB_NAME=<troque-isto>

# --- Servidor ---
PORT=3000

# --- Autenticação ---
# A chave que assina o token. Tem que ter 32 caracteres ou mais e não pode
# ser um texto de exemplo: o servidor recusa o boot se for. Uma frase só sua
# serve, mas não sirva a mesma em dois lugares.
JWT_SECRET=<troque-isto>
JWT_EXPIRES_IN=8h

# --- Bot ---
# Chave que o bot usa para criar pedidos. Mesma regra: invente a sua.
BOT_API_KEY=<troque-isto>

# --- CORS ---
# Endereços do navegador autorizados a chamar a API, separados por vírgula.
# Dentro do Codespace as URLs públicas entram sozinhas (ver config/origens.ts);
# aqui é para produção ou outro domínio.
CORS_ORIGENS=<troque-isto>
