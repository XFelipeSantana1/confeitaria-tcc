# Configuração local do ambiente. NÃO entra no Git (ver .gitignore).
#
# O `docker-compose.yml` lê daqui as credenciais do MySQL, e o `backend/.env`
# lê as dele. São dois arquivos porque cada um é lido por um programa
# diferente — e nenhum dos dois vai para o repositório.

MYSQL_ROOT_PASSWORD=<a senha que você inventou para o root>
MYSQL_DATABASE=confeitaria_db
MYSQL_USER=api_user
MYSQL_PASSWORD=<a senha que você inventou para o api_user>
